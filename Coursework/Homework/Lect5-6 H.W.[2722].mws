{SECT 0 {EXCHG {PARA 18 "" 0 "" {TEXT 323 15 "Assignment Five" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 218 11 " Problem 1." }{TEXT 324 3 "   " }
}{PARA 0 "" 0 "" {TEXT 324 0 "" }}{PARA 0 "" 0 "" {TEXT 324 44 "Genera
te 8 random 3 by 3 matrices using the " }{TEXT 219 12 "RandomMatrix" }
{TEXT 324 19 " command from the  " }{TEXT 220 13 "LinearAlgebra" }
{TEXT 324 42 " package. As each matrix is generated use " }{TEXT 221 
11 "Eigenvalues" }{TEXT 324 160 " to compute its eigenvalues. Then tak
e the product of the eigenvalues, and check that for each matrix, this
 product is equal to the determinant of the matrix.  " }}{PARA 0 "" 0 
"" {TEXT 324 0 "" }}{PARA 0 "" 0 "" {TEXT 324 1 "[" }{TEXT 222 6 "Hint
: " }{TEXT 324 79 "The product will be complicated algebraically and y
ou will need to apply first " }{TEXT 223 6 "expand" }{TEXT 324 7 ", th
en " }{TEXT 224 8 "simplify" }{TEXT 324 132 " to reduce the product of
 the eigenvalues to an integer. First try to do for a single matrix , \+
then make a loop to do it 8 times.]  " }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 8 "restart:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 20 
"with(LinearAlgebra):" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 22 "A:
=RandomMatrix(3,3);\n" }{MPLTEXT 1 0 38 "EvA:=simplify(evalf(Eigenvalu
es(A)));\n" }{MPLTEXT 1 0 22 "B:=RandomMatrix(3,3);\n" }{MPLTEXT 1 0 
37 "EvB:=simplify(evalf(Eigenvalues(B)));" }{MPLTEXT 1 0 1 "\n" }
{MPLTEXT 1 0 3 "C:=" }{MPLTEXT 1 0 19 "RandomMatrix(3,3);\n" }{MPLTEXT
 1 0 37 "EvC:=simplify(evalf(Eigenvalues(C)));" }{MPLTEXT 1 0 1 "\n" }
{MPLTEXT 1 0 3 "E:=" }{MPLTEXT 1 0 19 "RandomMatrix(3,3);\n" }{MPLTEXT
 1 0 37 "EvE:=simplify(evalf(Eigenvalues(E)));" }{MPLTEXT 1 0 1 "\n" }
{MPLTEXT 1 0 3 "F:=" }{MPLTEXT 1 0 18 "RandomMatrix(3,3);" }{MPLTEXT 
1 0 1 "\n" }{MPLTEXT 1 0 37 "EvF:=simplify(evalf(Eigenvalues(F)));" }
{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 0 3 "G:=" }{MPLTEXT 1 0 18 "RandomMatr
ix(3,3);" }{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 0 37 "EvG:=simplify(evalf(E
igenvalues(G)));" }{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 0 3 "H:=" }{MPLTEXT
 1 0 18 "RandomMatrix(3,3);" }{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 0 37 "Ev
H:=simplify(evalf(Eigenvalues(H)));" }{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 
