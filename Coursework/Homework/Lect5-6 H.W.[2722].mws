_syslibGF'6(-I%mrowGF$6#-I'mtableGF$69-I$mtrGF$6(-I$mtdGF$6(-I#mnGF$6&
Q\"1F'/%+foregroundGQ([0,0,0]F'/%)readonlyGQ&falseF'/%,mathvariantGQ'n
ormalF'/%)rowalignGQ!F'/%,columnalignGFF/%+groupalignGFF/%(rowspanGF:/
%+columnspanGF:F4F4FDFGFI-F26(-F56(-F86&Q\"2F'F;F>FAFDFGFIFKFMFQFQFDFG
FI-F26(-F56(-F86&Q\"3F'F;F>FAFDFGFIFKFMFXFXFDFGFIF;F>/%&alignGQ%axisF'
/FEQ)baselineF'/FHQ&rightF'/FJQ'|frleft|hrF'/%/alignmentscopeGQ%trueF'
/%,columnwidthGQ%autoF'/%&widthGFeo/%+rowspacingGQ&1.0exF'/%.columnspa
cingGQ&0.8emF'/%)rowlinesGQ%noneF'/%,columnlinesGF`p/%&frameGF`p/%-fra
mespacingGQ,0.4em~0.5exF'/%*equalrowsGF@/%-equalcolumnsGF@/%-displayst
yleGF@/%%sideGF]o/%0minlabelspacingGF]pF;F>FA/%%openGQ\"[F'/%&closeGQ
\"]F'" }}{PARA 11 "" 1 "" {XPPMATH 20 "I'MatrixG6$%*protectedGI(_sysli
