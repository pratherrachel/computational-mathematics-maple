0 "" }}}{EXCHG {PARA 18 "" 0 "" {TEXT 322 14 "Assignment Six" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 205 11 "Problem 1. " }}{PARA 0 "" 0 "" 
{TEXT 324 0 "" }}{PARA 0 "" 0 "" {TEXT 205 214 "If n people (numbered \+
1 to n) stand in a circle and someone starts going around the circle a
nd eliminating every other person till only one person is left, the nu
mber J(n) of the person left at the end is given by " }}{PARA 0 "" 0 "
" {TEXT 324 0 "" }}{PARA 0 "" 0 "" {TEXT 324 48 "    J(n) = 1         \+
                  if n = 1\n" }{TEXT 324 56 "    J(n) = 2*J(n/2) - 1  \+
        if n > 1 and n is even\n" }{TEXT 324 52 "    J(n) = 2*J((n-1)/
2) + 1   if  n > 1 and n is odd" }}{PARA 0 "" 0 "" {TEXT 324 0 "" }}
{PARA 0 "" 0 "" {TEXT 324 12 "(i) Write a " }{TEXT 285 9 "recursive" }
{TEXT 286 1 " " }{TEXT 287 9 "procedure" }{TEXT 324 115 " to compute J
. [As a check the first 16 values (starting with 1) of J(n) are 1,1,3,
1,3,5,7,1,3,5,7,9,11,13,15,1]. \n" }{TEXT 324 35 "(ii)Compute the valu
e of J(10000). " }}{PARA 0 "" 0 "" {TEXT 324 115 "(iii) Can you explai
n why this is so much faster than our recursive procedure to compute t
he n-th Fibonacci number?" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 
11 "J:=proc(n)\n" }{MPLTEXT 1 0 25 "local i, even, odd, Sol;\n" }
{MPLTEXT 1 0 12 "if n=1 then\n" }{MPLTEXT 1 0 12 "  return n;\n" }
{MPLTEXT 1 0 8 "end if;\n" }{MPLTEXT 1 0 9 "even:=0;\n" }{MPLTEXT 1 0 
7 "odd:=0;" }{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 0 21 "for i from 1 to n d
o\n" }{MPLTEXT 1 0 29 "  if type(i, even)=true then\n" }{MPLTEXT 1 0 
23 "    even:=(2*(i/2))-1;\n" }{MPLTEXT 1 0 15 "    Sol:=even;\n" }
{MPLTEXT 1 0 8 "  else \n" }{MPLTEXT 1 0 25 "    odd:=(2*((i-1)/2))+1;
" }{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 0 13 "    Sol:=odd\n" }{MPLTEXT 1 
0 10 "  end if;\n" }{MPLTEXT 1 0 8 "end do;\n" }{MPLTEXT 1 0 12 " even
; odd;\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 11 "J(1); J(3);" }}{PARA 11 "" 1 "" {XPPMATH 20 "\"\"\"" 
}}{PARA 11 "" 1 "" {XPPMATH 20 "\"\"$" }}}{EXCHG {PARA 0 "" 0 "" {TEXT
 205 11 "Problem 2. " }}{PARA 0 "" 0 "" {TEXT 324 0 "" }}{PARA 0 "" 0 
"" {TEXT 324 37 "Write a procedure using the variable " }{TEXT 288 4 "
args" }{TEXT 324 57 " that will take an unspecified finite number of n
umbers, " }{TEXT 289 35 "delete the smallest and the largest" }{TEXT 
324 2 ", " }{TEXT 290 62 "and return the average of the rest as a floa
ting point number." }{TEXT 324 131 " If there are fewer than 3 argumen
ts have an error message say: \"There are not enough arguments. There \+
should be at least three.\" \n" }{TEXT 324 1 "\n" }{TEXT 324 131 "You \+
should have no input parameters in the definition of the procedure. Yo
u may write it directly or you may use the Maple command " }{TEXT 291 
5 "sort " }{TEXT 324 30 "as a part of your program. Do " }{TEXT 292 6 
"?sort " }{TEXT 324 11 "to see how " }{TEXT 293 4 "sort" }{TEXT 324 
77 " works. Test your procedure with each of the following argument se
quences:  \n" }{TEXT 324 1 "\n" }{TEXT 324 24 "   50,40,40, 40, 40, 10
\n" }{TEXT 324 1 "\n" }{TEXT 324 7 "   1,2\n" }{TEXT 324 1 "\n" }{TEXT
 324 28 "   seq(100 - i, i = 1..100)\n" }{TEXT 324 1 "\n" }{TEXT 324 
31 "   seq(modp(n,111), n=1..1000)." }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 16 "probtwo:=proc()\n" }{MPLTEXT 1 0 22 "  local i, L, A,
 SUM;\n" }{MPLTEXT 1 0 19 "  L:=sort([args]):\n" }{MPLTEXT 1 0 10 "  S
UM:=0;\n" }{MPLTEXT 1 0 29 "  for i from 2 to nargs-1 do\n" }{MPLTEXT 
1 0 19 "    SUM:=SUM+L[i];\n" }{MPLTEXT 1 0 10 "  end do;\n" }{MPLTEXT
 1 0 31 "  return evalf(SUM/(nargs-2));\n" }{MPLTEXT 1 0 9 "end proc:"
 }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 50 "probtwo(50, 40, 40, 40, \+
40, 22, 37, 1002, 25, 10);" }}{PARA 11 "" 1 "" {XPPMATH 20 "$\"++++vO!
