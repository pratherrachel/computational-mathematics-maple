-------------------------------------" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 49 "S:=\{1,2,3,4,5,6\}; whattype(S); whattype(eval(S));" 
}}{PARA 11 "" 1 "" {XPPMATH 20 ">I\"SG6\"<(\"\"\"\"\"#\"\"$\"\"%\"\"&
\"\"'" }}{PARA 11 "" 1 "" {XPPMATH 20 "I$setG%*protectedG" }}{PARA 11 
