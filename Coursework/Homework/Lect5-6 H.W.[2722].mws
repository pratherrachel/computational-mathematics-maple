18 "" 0 "" {TEXT 323 14 "Assignment Six" }}}{EXCHG {PARA 0 "" 0 "" 
{TEXT 205 11 "Problem 1. " }}{PARA 0 "" 0 "" {TEXT 324 0 "" }}{PARA 0 
"" 0 "" {TEXT 205 214 "If n people (numbered 1 to n) stand in a circle
 and someone starts going around the circle and eliminating every othe
r person till only one person is left, the number J(n) of the person l
eft at the end is given by " }}{PARA 0 "" 0 "" {TEXT 324 0 "" }}{PARA 
0 "" 0 "" {TEXT 324 48 "    J(n) = 1                           if n = \+
1\n" }{TEXT 324 56 "    J(n) = 2*J(n/2) - 1          if n > 1 and n is
 even\n" }{TEXT 324 52 "    J(n) = 2*J((n-1)/2) + 1   if  n > 1 and n \+
is odd" }}{PARA 0 "" 0 "" {TEXT 324 0 "" }}{PARA 0 "" 0 "" {TEXT 324 
12 "(i) Write a " }{TEXT 286 9 "recursive" }{TEXT 287 1 " " }{TEXT 
288 9 "procedure" }{TEXT 324 115 " to compute J. [As a check the first
 16 values (starting with 1) of J(n) are 1,1,3,1,3,5,7,1,3,5,7,9,11,13
,15,1]. \n" }{TEXT 324 35 "(ii)Compute the value of J(10000). " }}
{PARA 0 "" 0 "" {TEXT 324 115 "(iii) Can you explain why this is so mu
ch faster than our recursive procedure to compute the n-th Fibonacci n
umber?" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "J:=proc(n)\n" }
{MPLTEXT 1 0 25 "local i, even, odd, Sol;\n" }{MPLTEXT 1 0 12 "if n=1 \+
then\n" }{MPLTEXT 1 0 12 "  return n;\n" }{MPLTEXT 1 0 8 "end if;\n" }
{MPLTEXT 1 0 9 "even:=0;\n" }{MPLTEXT 1 0 7 "odd:=0;" }{MPLTEXT 1 0 1 
"\n" }{MPLTEXT 1 0 21 "for i from 1 to n do\n" }{MPLTEXT 1 0 29 "  if \+
type(i, even)=true then\n" }{MPLTEXT 1 0 23 "    even:=(2*(i/2))-1;\n"
 }{MPLTEXT 1 0 15 "    Sol:=even;\n" }{MPLTEXT 1 0 8 "  else \n" }
{MPLTEXT 1 0 25 "    odd:=(2*((i-1)/2))+1;" }{MPLTEXT 1 0 1 "\n" }
{MPLTEXT 1 0 13 "    Sol:=odd\n" }{MPLTEXT 1 0 10 "  end if;\n" }
{MPLTEXT 1 0 8 "end do;\n" }{MPLTEXT 1 0 12 " even; odd;\n" }{MPLTEXT 
1 0 9 "end proc:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "J(1); J
(3);" }}{PARA 11 "" 1 "" {XPPMATH 20 "\"\"\"" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "\"\"$" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 205 11 "Problem 2.
 " }}{PARA 0 "" 0 "" {TEXT 324 0 "" }}{PARA 0 "" 0 "" {TEXT 324 37 "Wr
ite a procedure using the variable " }{TEXT 289 4 "args" }{TEXT 324 
57 " that will take an unspecified finite number of numbers, " }{TEXT 
290 35 "delete the smallest and the largest" }{TEXT 324 2 ", " }{TEXT 
291 62 "and return the average of the rest as a floating point number.
" }{TEXT 324 131 " If there are fewer than 3 arguments have an error m
essage say: \"There are not enough arguments. There should be at least
 three.\" \n" }{TEXT 324 1 "\n" }{TEXT 324 131 "You should have no inp
ut parameters in the definition of the procedure. You may write it dir
ectly or you may use the Maple command " }{TEXT 292 5 "sort " }{TEXT 
324 30 "as a part of your program. Do " }{TEXT 293 6 "?sort " }{TEXT 
324 11 "to see how " }{TEXT 294 4 "sort" }{TEXT 324 77 " works. Test y
our procedure with each of the following argument sequences:  \n" }
{TEXT 324 1 "\n" }{TEXT 324 24 "   50,40,40, 40, 40, 10\n" }{TEXT 324 
1 "\n" }{TEXT 324 7 "   1,2\n" }{TEXT 324 1 "\n" }{TEXT 324 28 "   seq
(100 - i, i = 1..100)\n" }{TEXT 324 1 "\n" }{TEXT 324 31 "   seq(modp(
n,111), n=1..1000)." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 16 "prob
two:=proc()\n" }{MPLTEXT 1 0 22 "  local i, L, A, SUM;\n" }{MPLTEXT 1 
0 19 "  L:=sort([args]):\n" }{MPLTEXT 1 0 10 "  SUM:=0;\n" }{MPLTEXT 
1 0 29 "  for i from 2 to nargs-1 do\n" }{MPLTEXT 1 0 19 "    SUM:=SUM
+L[i];\n" }{MPLTEXT 1 0 10 "  end do;\n" }{MPLTEXT 1 0 31 "  return ev
alf(SUM/(nargs-2));\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG {PARA 0 "
> " 0 "" {MPLTEXT 1 0 50 "probtwo(50, 40, 40, 40, 40, 22, 37, 1002, 25
, 10);" }}{PARA 11 "" 1 "" {XPPMATH 20 "$\"++++vO!\")" }}}{EXCHG 
