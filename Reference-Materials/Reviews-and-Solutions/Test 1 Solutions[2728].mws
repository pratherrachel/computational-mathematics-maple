cal X,i,c,k,j;\n" }{MPLTEXT 1 0 30 "X:=evalf[n](sqrt(123456789));\n" }
{MPLTEXT 1 0 11 "Digits:=n;\n" }{MPLTEXT 1 0 22 "X:=floor(10^(n-1)*X);
\n" }{MPLTEXT 1 0 24 "X:=convert(X,base, 10);\n" }{MPLTEXT 1 0 38 "for
 i from 0 to 9 do c[i]:=0; end do;\n" }{MPLTEXT 1 0 22 " for k from 1 \+
to n do\n" }{MPLTEXT 1 0 11 "  j:=X[k];\n" }{MPLTEXT 1 0 16 "  c[j]:=c
[j]+1;\n" }{MPLTEXT 1 0 9 " end do:\n" }{MPLTEXT 1 0 20 "[seq(c[j],j=0
..9)];\n" }{MPLTEXT 1 0 13 "return c[6];\n" }{MPLTEXT 1 0 10 "end proc
