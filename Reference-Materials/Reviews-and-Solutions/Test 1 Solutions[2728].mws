{EXCHG {PARA 0 "" 0 "" {TEXT 206 12 "Problem 3 a:" }}}{EXCHG {PARA 0 "
> " 0 "" {MPLTEXT 1 0 17 "sumcube:=proc(n)\n" }{MPLTEXT 1 0 16 "local \+
x,y,Sols;\n" }{MPLTEXT 1 0 10 "Sols:=\{\};\n" }{MPLTEXT 1 0 40 "for x \+
from 1 to evalf(root((n/2),3)) do\n" }{MPLTEXT 1 0 22 "  y:= root(n-x^
3, 3);\n" }{MPLTEXT 1 0 26 "  if type(y, posint) then\n" }{MPLTEXT 1 
0 31 "    Sols:= Sols union \{[x,y]\};\n" }{MPLTEXT 1 0 10 "  end if;
\n" }{MPLTEXT 1 0 8 "end do;\n" }{MPLTEXT 1 0 13 "return Sols;\n" }
{MPLTEXT 1 0 10 "end proc:\n" }{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 0 16 "f
or n from 1 do\n" }{MPLTEXT 1 0 30 "  if nops(sumcube(n))> 1 then\n" }
{MPLTEXT 1 0 26 "    print(n, sumcube(n));\n" }{MPLTEXT 1 0 11 "    br
eak;\n" }{MPLTEXT 1 0 10 "  end if;\n" }{MPLTEXT 1 0 7 "end do;" }
