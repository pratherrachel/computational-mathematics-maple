{SECT 0 {EXCHG {PARA 209 "" 0 "" {TEXT 206 21 "Review Questions - 03"
 }}{PARA 0 "" 0 "" {TEXT 259 0 "" }}{PARA 0 "" 0 "" {TEXT 211 6 "Note:
 " }{TEXT 212 201 "Please answer the following questions to review Lec
ture 3. You may need to try some Maple commands and answer the review \+
questions under the help of your lecture notes and the Maple built-in \+
help menu." }}{PARA 0 "" 0 "" {TEXT 259 0 "" }}}{EXCHG {PARA 0 "" 0 ""
 {TEXT 259 2 "1." }{TEXT 213 1 " " }{TEXT 259 59 " What is the output \+
of the following sequence of commands?\n" }{TEXT 259 4 "    " }{TEXT 
214 17 "> (x, y):=(1,1):\n" }{TEXT 215 17 "    > f:=proc(n)\n" }{TEXT 
216 21 "            local x;\n" }{TEXT 217 22 "            global y;\n
" }{TEXT 218 19 "            x:=10;\n" }{TEXT 219 19 "            y:=1
0;\n" }{TEXT 220 25 "           return n*x*y;\n" }{TEXT 221 17 "      \+
 end proc:\n" }{TEXT 222 17 "   >  f(2), x, y;" }}{PARA 0 "" 0 "" 
{TEXT 259 0 "" }}{PARA 0 "" 0 "" {TEXT 259 10 "Solution: " }}{PARA 0 "
" 0 "" {TEXT 259 25 "The output is 200, 1, 10." }}{PARA 0 "" 0 "" 
{TEXT 259 0 "" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 13 "(x,y):=(1,
1):" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "f:=proc(n)\n" }
{MPLTEXT 1 0 12 "   local x;\n" }{MPLTEXT 1 0 13 "   global y;\n" }
{MPLTEXT 1 0 10 "   x:=10;\n" }{MPLTEXT 1 0 10 "   y:=10;\n" }{MPLTEXT
 1 0 17 "   return n*x*y;\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 9 "f(2),x,y;" }}{PARA 6 "" 1 "" {TEXT 
260 10 "200, 1, 10" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 206 0 "" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 206 0 "" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 
259 0 "" }}{PARA 0 "" 0 "" {TEXT 259 62 "2.  What is the output of the
 following sequence of commands:\n" }{TEXT 259 2 "  " }{TEXT 223 23 ">
 for n from 3 to 7 do\n" }{TEXT 224 20 "        print(n^2);\n" }{TEXT 
225 38 "        if n >= 4 then break; end if;\n" }{TEXT 226 13 "     e
nd do;\n" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 206 10 "Solution: " }}{PARA 
0 "" 0 "" {TEXT 206 51 "The output of the sequence of commands is 9 an
d 16." }}{PARA 0 "" 0 "" {TEXT 206 0 "" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 21 "for n from 3 to 7 do\n" }{MPLTEXT 1 0 14 "  print(n^2
);\n" }{MPLTEXT 1 0 32 "  if n >= 4 then break; end if;\n" }{MPLTEXT 
1 0 7 "end do;" }}{PARA 6 "" 1 "" {TEXT 260 1 "9" }}{PARA 6 "" 1 "" 
{TEXT 260 2 "16" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 259 0 "" }}{PARA 0 "" 0 "" {TEXT 259 61 "
3. What is the output of the following sequence of commands:\n" }{TEXT
 259 2 "  " }{TEXT 227 23 "> for n from 3 to 7 do\n" }{TEXT 228 38 "  \+
      if n >= 4 then break; end if;\n" }{TEXT 229 20 "        print(n^
2);\n" }{TEXT 230 12 "    end do;\n" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 
206 10 "Solution: " }}{PARA 0 "" 0 "" {TEXT 206 45 "The out of the seq
uence of commands is just 9" }}{PARA 0 "" 0 "" {TEXT 206 0 "" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 21 "for n from 3 to 7 do\n" }
{MPLTEXT 1 0 32 "  if n >= 4 then break; end if;\n" }{MPLTEXT 1 0 14 "
  print(n^2);\n" }{MPLTEXT 1 0 7 "end do;" }}{PARA 6 "" 1 "" {TEXT 
260 1 "9" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}{EXCHG 
{PARA 0 "" 0 "" {TEXT 259 0 "" }}{PARA 0 "" 0 "" {TEXT 259 75 "4. Test
 the following two sequences of commands to find their difference: \n"
 }{TEXT 259 2 "  " }{TEXT 231 23 "> for n from 1 to 4 do\n" }{TEXT 
232 37 "        if n >= 2 then next; end if;\n" }{TEXT 233 20 "       \+
 print(n^2);\n" }{TEXT 234 12 "    end do;\n" }{TEXT 259 1 " " }{TEXT 
235 23 "> for n from 1 to 4 do\n" }{TEXT 236 20 "        print(n^2);\n
" }{TEXT 237 37 "        if n >= 2 then next; end if;\n" }{TEXT 238 
11 "    end do;" }}{PARA 0 "" 0 "" {TEXT 259 0 "" }}}{EXCHG {PARA 0 ""
 0 "" {TEXT 206 11 "Solution: \n" }{TEXT 206 167 "The position of the \+
phrase next changes the sequences, the first sequences ends after the \+
inital input while the second is able to continue on until the limitin
g term." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 21 "for n from 1 to \+
4 do\n" }{MPLTEXT 1 0 31 "  if n >= 2 then next; end if;\n" }{MPLTEXT 
1 0 14 "  print(n^2);\n" }{MPLTEXT 1 0 7 "end do;" }}{PARA 6 "" 1 "" 
{TEXT 260 1 "1" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 21 "for n fro
m 1 to 4 do\n" }{MPLTEXT 1 0 14 "  print(n^2);\n" }{MPLTEXT 1 0 31 "  \+
if n >= 2 then next; end if;\n" }{MPLTEXT 1 0 7 "end do;" }}{PARA 6 ""
 1 "" {TEXT 260 1 "1" }}{PARA 6 "" 1 "" {TEXT 260 2 "4\n" }{TEXT 260 
2 "9\n" }{TEXT 260 2 "16" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 259 0 "" }}
{PARA 0 "" 0 "" {TEXT 259 75 "5. Find the smallest integer n between 1
 and 100 which satisfies 3^n>10^5.\n" }{TEXT 259 1 " " }}}{EXCHG 
{PARA 0 "" 0 "" {TEXT 206 10 "Solution: " }}{PARA 0 "" 0 "" {TEXT 206 
72 "The smallest integer n between 1 and 100 which satisfies 3^n?10^5 \+
is 11." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 23 "for n from 1 to 1
00 do\n" }{MPLTEXT 1 0 46 "  if 3^n > 10^5 then print(n); break; end i
f;\n" }{MPLTEXT 1 0 7 "end do;" }}{PARA 6 "" 1 "" {TEXT 260 2 "11" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}{EXCHG {PARA 0 "" 0 "" 
{TEXT 206 3 "The" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 259 0 "" }}{PARA 0 "
" 0 "" {TEXT 259 87 "6. What are the outputs of the following two comm
ands involving the logical operators, " }{TEXT 239 3 "xor" }{TEXT 259 
5 " and " }{TEXT 240 7 "implies" }{TEXT 259 1 ":" }{TEXT 241 1 "\n" }
{TEXT 242 20 "  >1<2 xor 1+a<2+a;\n" }{TEXT 243 23 "  >2>3 implies 2+a
>1+a;" }}{PARA 0 "" 0 "" {TEXT 259 0 "" }}}{EXCHG {PARA 0 "" 0 "" 
{TEXT 206 10 "Solution: " }}{PARA 0 "" 0 "" {TEXT 206 71 "These are re
lation operators where the output is given out differently." }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 16 "1<2 xor 1+a<2+a;" }}{PARA 6 
"" 1 "" {TEXT 260 11 "not a < 1+a" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 20 "2>3 implies 2+a>1+a;" }}{PARA 6 "" 1 "" {TEXT 260 4 "
true" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}{EXCHG {PARA 0 
"" 0 "" {TEXT 259 0 "" }}{PARA 0 "" 0 "" {TEXT 259 139 "7. Write a sho
rt program whose output will be the set of all 2 element sets \{i,j\} \+
where i < j  and  i,j are in the set \{1, 2, . . . , 10\}:\n" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 206 10 "Solution: " }}{PARA 0 "" 0 "" 
{TEXT 206 17 "See program below" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 
1 0 7 "S:=\{\}:\n" }{MPLTEXT 1 0 22 "for i from 1 to 10 do\n" }
{MPLTEXT 1 0 24 "  for j from 1 to 10 do\n" }{MPLTEXT 1 0 38 "    if i
<j then S:= S union \{[i,j]\}; \n" }{MPLTEXT 1 0 12 "    end if;\n" }
{MPLTEXT 1 0 10 "  end do;\n" }{MPLTEXT 1 0 8 "end do;\n" }{MPLTEXT 1 
0 9 "print(S);" }}{PARA 6 "" 1 "" {TEXT 260 369 "\{[1, 2], [1, 3], [1,
 4], [1, 5], [1, 6], [1, 7], [1, 8], [1, 9], [1, 10], [2, 3], [2, 4], \+
[2, 5], [2, 6], [2, 7], [2, 8], [2, 9], [2, 10], [3, 4], [3, 5], [3, 6
], [3, 7], [3, 8], [3, 9], [3, 10], [4, 5], [4, 6], [4, 7], [4, 8], [4
, 9], [4, 10], [5, 6], [5, 7], [5, 8], [5, 9], [5, 10], [6, 7], [6, 8]
, [6, 9], [6, 10], [7, 8], [7, 9], [7, 10], [8, 9], [8, 10], [9, 10]\}
" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}{EXCHG {PARA 0 "" 0
 "" {TEXT 259 0 "" }}{PARA 0 "" 0 "" {TEXT 259 66 "8. Which of the fol
lowing are legitimate variable names in Maple:\n" }{TEXT 259 27 "  a. \+
 temperature of water\n" }{TEXT 259 27 "  b. `temperature of water`" }
}{PARA 0 "" 0 "" {TEXT 259 27 "  c.  temperature_of_water\n" }{TEXT 
259 15 "  d. 3variable\n" }{TEXT 259 16 "  e.  variable3\n" }{TEXT 
259 8 "  f.   D" }}{PARA 0 "" 0 "" {TEXT 259 9 "  g.   I\n" }{TEXT 
259 91 "Note that the symbol in g is not \"one\" or \"el\", rather the
 capital letter pronounced \"eye\"." }}{PARA 0 "" 0 "" {TEXT 259 0 "" 
}}}{EXCHG {PARA 0 "" 0 "" {TEXT 206 10 "Solution: " }}{PARA 0 "" 0 "" 
{TEXT 206 29 "The variables are B, C, and E" }}}{EXCHG {PARA 0 "" 0 ""
 {TEXT 259 0 "" }}{PARA 0 "" 0 "" {TEXT 259 51 "9. What are the output
s of the following programs:\n" }{TEXT 259 2 "  " }{TEXT 244 11 "> res
tart:\n" }{TEXT 245 18 "     assigned(x);\n" }{TEXT 246 14 "   > resta
rt:\n" }{TEXT 247 12 "      x:=1:\n" }{TEXT 248 18 "      assigned(x);
" }{TEXT 259 1 "\n" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 206 10 "Solution: 
