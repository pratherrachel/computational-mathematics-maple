413 23 "Here are some examples:" }}{PARA 0 "" 0 "" {TEXT 413 0 "" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 36 "L:=[-3.4,-3.6,3.6,3.5,3.4,3.
5,3,-3]:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 14 "for x in L do\n
" }{MPLTEXT 1 0 94 "  print(`if x = `,x,` round(x) = `,round(x),`  flo
or(x) = `,floor(x),`  ceil(x) = `,ceil(x));\n" }{MPLTEXT 1 0 7 "end do
;" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 413 25 "Sometimes one must apply " 
}{TEXT 317 5 "evalf" }{TEXT 413 46 " before invoking these functions. \+
For example:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 17 "floor(sin(1
0^8));" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 413 41 "But  floor cannot eval
uate the following." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 18 "floo
r(sin(10^10));" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 413 42 "We must first \+
apply evalf to make it work." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 
0 25 "floor(evalf(sin(10^10)));" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 
1 0 22 "floor(sqrt(10^9 + 1));" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 413 
31 "However, compare the following:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 23 "floor(sqrt(10^10 + 1));" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 28 "floor(evalf(sqrt(10^10+1)));" }}}{EXCHG {PARA 0 "> " 
0 "" {MPLTEXT 1 0 31 "floor(evalf(sqrt(10^100 + 1)));" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}}{SECT 1 {PARA 3 "" 0 "" {TEXT 
412 14 "The digits of " }{XPPEDIT 18 0 "Typesetting:-mrow(Typesetting:
-mi(\"&pi;\", italic = \"false\", mathvariant = \"normal\"));" "-I%mro
wG6#/I+modulenameG6\"I,TypesettingGI(_syslibGF'6#-I#miGF$6%Q%&pi;F'/%'
italicGQ&falseF'/%,mathvariantGQ'normalF'" }{TEXT 412 1 " " }}{EXCHG 
{PARA 210 "" 0 "" {TEXT 209 140 "Here we write a procedure to explore \+
the question of whether or not the digits 0 to 9 are uniformly distrib
uted among the first N digits of " }{XPPEDIT 209 0 "Typesetting:-mrow(
Typesetting:-mi(\"&pi;\", italic = \"false\", font_style_name = \"Char
acterStyle262\", mathvariant = \"normal\"));" "-I%mrowG6#/I+modulename
G6\"I,TypesettingGI(_syslibGF'6#-I#miGF$6&Q%&pi;F'/%'italicGQ&falseF'/
%0font_style_nameGQ2CharacterStyle262F'/%,mathvariantGQ'normalF'" }
{TEXT 414 0 "" }{TEXT 209 1 "." }{TEXT 414 1 "\n" }}}{EXCHG {PARA 0 ""
 0 "" {TEXT 413 16 "Use the command " }{TEXT 318 13 "?convert/base" }
{TEXT 413 37 " to find out more about the function " }{TEXT 319 7 "con
vert" }{TEXT 413 25 " used below.  Actually,  " }{TEXT 320 7 "convert"
 }{TEXT 413 60 " has many uses in Maple, as we will see later in the c
ourse." }}}{EXCHG {PARA 0 "" 0 "" {TEXT 413 0 "" }}{PARA 0 "" 0 "" 
{TEXT 321 6 "Digits" }{TEXT 413 129 " is an \"environmental\" variable
 that tells how many digits are carried in floating point operations. \+
The default is 10 as we see:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 
0 8 "restart;" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 7 "Digits;" }}
}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 10 "evalf(Pi);" }}}{EXCHG 
{PARA 0 "" 0 "" {TEXT 413 79 "The following sets the number of digit c
arried by floating point numbers to 30:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 11 "Digits:=30;" }{TEXT 413 5 " but " }{TEXT 322 8 "\"dig
its\"" }{TEXT 413 24 " with lower case letter " }{TEXT 323 1 "d" }
{TEXT 413 14 " doesn't work." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 
0 10 "evalf(Pi);" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 413 72 "Now we set t
he number of digits carried by floating point numbers to 3. " }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 6 "n:=3:\n" }{MPLTEXT 1 0 11 "Di
gits:=3; " }}{PARA 0 "" 0 "" {TEXT 413 0 "" }}}{EXCHG {PARA 0 "> " 0 "
" {MPLTEXT 1 0 13 "X:=evalf(Pi);" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT
 1 0 11 "10^(n-1)*X;" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 22 "X:=
floor(10^(n-1)*X); " }{TEXT 413 51 "This converts X to an integer with
 the same digits." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 24 "X:=con
vert(X,base, 10); " }{TEXT 413 178 "Note the digits appear in reversed
 order, but they are now in a list which makes them easier to handle. \+
There are alternative ways to get at the digits that we may discuss la
ter." }}}{EXCHG {PARA 0 "" 0 "" {TEXT 413 51 "Let's do this again with
 n = 100 instead of just 3:" }}{PARA 0 "" 0 "" {TEXT 413 0 "" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "n:=100;\n" }{MPLTEXT 1 0 11 "
Digits:=n;\n" }{MPLTEXT 1 0 16 "X:=evalf(Pi,n);\n" }{MPLTEXT 1 0 22 "X
:=floor(10^(n-1)*X);\n" }{MPLTEXT 1 0 23 "X:=convert(X,base, 10);" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "nops(X);" }}}{EXCHG {PARA 0 "
" 0 "" {TEXT 413 85 "Now we shall count the number of times each digit
 appears in the first 100 digits of " }{XPPEDIT 18 0 "Typesetting:-mro
w(Typesetting:-mi(\"&pi;\", italic = \"false\", mathvariant = \"normal
\"));" "-I%mrowG6#/I+modulenameG6\"I,TypesettingGI(_syslibGF'6#-I#miGF
$6%Q%&pi;F'/%'italicGQ&falseF'/%,mathvariantGQ'normalF'" }{TEXT 413 
146 ". We will let c[0] be the number of times 0 appears, c[1] be the \+
number of times 1 appears, etc... First we initialize the 10 variables
 c[i] to 0." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 37 "for i from 0
 to 9 do c[i]:=0; end do:" }{TEXT 413 0 "" }}}{EXCHG {PARA 0 "> " 0 ""
 {MPLTEXT 1 0 21 "for k from 1 to n do\n" }{MPLTEXT 1 0 12 "  j:=X[k];
 \n" }{MPLTEXT 1 0 18 "  c[j]:=c[j] + 1;\n" }{MPLTEXT 1 0 7 "end do:" 
}}}{EXCHG {PARA 0 "" 0 "" {TEXT 413 65 "Now we exhibit the values of t
he c[i]'s in a sequence as follows:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 19 "[seq(c[j],j=0..9)];" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 
413 86 "This says that the digit 0 appears 8 time, 1 appears 8 times, \+
2 appears 12 times, etc." }}{PARA 0 "" 0 "" {TEXT 413 0 "" }}}{EXCHG 
{PARA 0 "" 0 "" {TEXT 413 77 "Another way to do the counting is as fol
lows: First set the c[i]'s back to 0:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 37 "for i from 0 to 9 do c[i]:=0; end do:" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 22 "for k from 1 to n do \n" }{MPLTEXT 
1 0 24 "  c[X[k]]:=c[X[k]] + 1;\n" }{MPLTEXT 1 0 7 "end do:" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 19 "[seq(c[j],j=0..9)];" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 413 19 "Now we construct a " }{TEXT 324 
9 "procedure" }{TEXT 413 76 " to compute the number of times each digi
t appears in the first n digits of " }{XPPEDIT 18 0 "Typesetting:-mrow
(Typesetting:-mi(\"&pi;\", italic = \"false\", mathvariant = \"normal
