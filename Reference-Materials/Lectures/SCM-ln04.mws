 " 0 "" {MPLTEXT 1 0 9 "restart:\n" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 7 "n:=40;\n" }{MPLTEXT 1 0 11 "Digits:=n;\n" }{MPLTEXT 1 
0 16 "X:=evalf(Pi,n);\n" }{MPLTEXT 1 0 22 "X:=floor(10^(n-1)*X);\n" }
{MPLTEXT 1 0 24 "X:=convert(X,base, 10);\n" }{MPLTEXT 1 0 2 "  " }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 38 "for i from 0 to 9 do c[i]:=0
; end do:\n" }{MPLTEXT 1 0 2 "  " }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT
 1 0 21 "for k from 1 to n do\n" }{MPLTEXT 1 0 13 "   j:=X[k]; \n" }
{MPLTEXT 1 0 19 "   c[j]:=c[j] + 1;\n" }{MPLTEXT 1 0 7 "end do:" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 19 "[seq(c[j],j=0..9)];" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 413 34 "Now we make this into a procedure
:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 19 "numdigits:=proc(n)\n" 
}{MPLTEXT 1 0 19 "  local X,c,i,k,j;\n" }{MPLTEXT 1 0 13 "  Digits:=n:
\n" }{MPLTEXT 1 0 18 "  X:=evalf(Pi,n);\n" }{MPLTEXT 1 0 24 "  X:=floo
r(10^(n-1)*X):\n" }{MPLTEXT 1 0 26 "  X:=convert(X,base, 10):\n" }
{MPLTEXT 1 0 40 "  for i from 0 to 9 do c[i]:=0; end do:\n" }{MPLTEXT 
1 0 23 "  for k from 1 to n do\n" }{MPLTEXT 1 0 16 "    j:=X[k];   \n"
 }{MPLTEXT 1 0 20 "    c[j]:=c[j] + 1;\n" }{MPLTEXT 1 0 10 "  end do:
\n" }{MPLTEXT 1 0 22 "  [seq(c[j],j=0..9)];\n" }{MPLTEXT 1 0 9 "end pr
oc:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 15 "numdigits(100);" }}}
