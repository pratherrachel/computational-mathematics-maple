6\"I,TypesettingGI(_syslibGF'6%-I#miGF$6#Q!F'-F#6'-I+munderoverGF$6'-I
#moGF$6/Q&&Sum;F'/%+foregroundGQ.[144,144,144]F'/%,mathvariantGQ'norma
lF'/I+msemanticsGF$Q&inertF'/%&fenceGQ&falseF'/%*separatorGFC/%)stretc
