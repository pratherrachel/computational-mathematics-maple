{MPLTEXT 1 230 16 "  return Total;\n" }{MPLTEXT 1 230 10 "end proc:\n"
 }}}{EXCHG {PARA 209 "" 0 "" {TEXT 228 36 "We apply this to n = 4 and \+
n = 1000:" }}}{EXCHG {PARA 209 "> " 0 "" {MPLTEXT 1 230 6 "F(4);\n" }}
}{EXCHG {PARA 209 "> " 0 "" {MPLTEXT 1 230 8 "F(1000);" }}}{EXCHG 
{PARA 209 "" 0 "" {TEXT 228 42 "Now we make a procedure that will comp
ute " }{XPPEDIT 18 0 "Typesetting:-mrow(Typesetting:-mi(\"\"), Typeset
ting:-mrow(Typesetting:-munderover(Typesetting:-mo(\"&Sum;\", mathvari
ant = \"normal\", fence = \"false\", separator = \"false\", stretchy =
 \"true\", symmetric = \"false\", largeop = \"true\", movablelimits = \+
\"true\", accent = \"false\", lspace = \"0.0em\", rspace = \"0.1666667
em\"), Typesetting:-mrow(Typesetting:-mi(\"i\", italic = \"true\", mat
hvariant = \"italic\"), Typesetting:-mo(\"=\", mathvariant = \"normal
\", fence = \"false\", separator = \"false\", stretchy = \"false\", sy
mmetric = \"false\", largeop = \"false\", movablelimits = \"false\", a
ccent = \"false\", lspace = \"0.2777778em\", rspace = \"0.2777778em\")
, Typesetting:-mi(\"a\", italic = \"true\", mathvariant = \"italic\"))
, Typesetting:-mi(\"b\", italic = \"true\", mathvariant = \"italic\"),
 accent = \"false\", accentunder = \"false\"), Typesetting:-mi(\"\"), \+
Typesetting:-mspace(height = \"0.0ex\", width = \"5.0\", depth = \"0.0
