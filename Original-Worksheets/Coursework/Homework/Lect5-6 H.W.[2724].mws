0 "" {TEXT 285 14 "Assignment Six" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 
205 11 "Problem 1. " }}{PARA 0 "" 0 "" {TEXT 287 0 "" }}{PARA 0 "" 0 "
" {TEXT 205 214 "If n people (numbered 1 to n) stand in a circle and s
omeone starts going around the circle and eliminating every other pers
on till only one person is left, the number J(n) of the person left at
 the end is given by " }}{PARA 0 "" 0 "" {TEXT 287 0 "" }}{PARA 0 "" 0
 "" {TEXT 287 48 "    J(n) = 1                           if n = 1\n" }
{TEXT 287 56 "    J(n) = 2*J(n/2) - 1          if n > 1 and n is even
\n" }{TEXT 287 52 "    J(n) = 2*J((n-1)/2) + 1   if  n > 1 and n is od
d" }}{PARA 0 "" 0 "" {TEXT 287 0 "" }}{PARA 0 "" 0 "" {TEXT 287 12 "(i
) Write a " }{TEXT 282 9 "recursive" }{TEXT 283 1 " " }{TEXT 284 9 "pr
ocedure" }{TEXT 287 115 " to compute J. [As a check the first 16 value
s (starting with 1) of J(n) are 1,1,3,1,3,5,7,1,3,5,7,9,11,13,15,1]. \+
\n" }{TEXT 287 35 "(ii)Compute the value of J(10000). " }}{PARA 0 "" 0
 "" {TEXT 287 115 "(iii) Can you explain why this is so much faster th
an our recursive procedure to compute the n-th Fibonacci number?" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "J:=proc(n)\n" }{MPLTEXT 1 0 
25 "local i, even, odd, Sol;\n" }{MPLTEXT 1 0 12 "if n=1 then\n" }
{MPLTEXT 1 0 12 "  return n;\n" }{MPLTEXT 1 0 8 "end if;\n" }{MPLTEXT 
1 0 9 "even:=0;\n" }{MPLTEXT 1 0 7 "odd:=0;" }{MPLTEXT 1 0 1 "\n" }
{MPLTEXT 1 0 21 "for i from 1 to n do\n" }{MPLTEXT 1 0 29 "  if type(i
, even)=true then\n" }{MPLTEXT 1 0 23 "    even:=(2*(i/2))-1;\n" }
{MPLTEXT 1 0 15 "    Sol:=even;\n" }{MPLTEXT 1 0 8 "  else \n" }
{MPLTEXT 1 0 25 "    odd:=(2*((i-1)/2))+1;" }{MPLTEXT 1 0 1 "\n" }
{MPLTEXT 1 0 13 "    Sol:=odd\n" }{MPLTEXT 1 0 10 "  end if;\n" }
{MPLTEXT 1 0 8 "end do;\n" }{MPLTEXT 1 0 7 " even;\n" }{MPLTEXT 1 0 9 
"end proc:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "J(1); J(2);" 
}}{PARA 11 "" 1 "" {XPPMATH 20 "\"\"\"" }}{PARA 11 "" 1 "" {XPPMATH 20
 "\"\"!" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}}
{MARK "0 0 0" 0 }{VIEWOPTS 1 1 0 1 1 1803 1 1 1 1 }{PAGENUMBERS 0 1 2
 33 1 1 }