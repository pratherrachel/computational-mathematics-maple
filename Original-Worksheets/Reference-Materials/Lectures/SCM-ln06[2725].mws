e remember table for sin." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 
17 "op(4, eval(sin));" }}{PARA 11 "" 1 "" {XPPMATH 20 "KI&CacheG6$%*pr
otectedGI(_syslibG6\"6%\"$7&/.I*temporaryGF'7$/,$*&#\"\"\"\"#<F2I#PiGF
%F2F2-I$sinGF$6#F//,$*&#F2\"#7F2F4F2F2,$*(#F2\"\"%F2)\"\"##F2FBF2,&*$)
\"\"$FCF2F2F2!\"\"F2F2/.I*permanentGF'7+/\"\"!FN/,$*&FCF2F4F2F2F2/F4FN
