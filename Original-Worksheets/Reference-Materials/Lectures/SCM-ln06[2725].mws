lse\", symmetric = \"false\", largeop = \"false\", movablelimits = \"f
alse\", accent = \"false\", lspace = \"0.2777778em\", rspace = \"0.277
7778em\"), Typesetting:-mn(\"20\", mathvariant = \"normal\")), Typeset
ting:-mi(\"\"));" "-I%mrowG6#/I+modulenameG6\"I,TypesettingGI(_syslibG
F'6%-I#miGF$6#Q!F'-F#6%-F,6%Q\"nF'/%'italicGQ%trueF'/%,mathvariantGQ'i
talicF'-I#moGF$6-Q%&le;F'/F8Q'normalF'/%&fenceGQ&falseF'/%*separatorGF
