"" }}{PARA 0 "" 0 "" {TEXT 440 199 "The following allows us to generat
e all 2 element subsets of  \{1,2,3,4\}. Note carefully that the index
 j goes from i+1 to 4 so that j is always greater than i.  This is leg
itimate in this case since " }{TEXT 297 13 "\{i,j\} = \{j,i\}" }{TEXT 
440 27 " and so we may assume that " }{TEXT 298 5 "i < j" }{TEXT 440 
2 ". " }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 21 "for i from 1 to 4 do\n" }{MPLTEXT 1 0 26 "   for j fr
om i+1 to 4 do\n" }{MPLTEXT 1 0 19 "     print(\{i,j\});\n" }{MPLTEXT 
1 0 11 "   end do;\n" }{MPLTEXT 1 0 7 "end do;" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "<$\"\"\"\"\"#" }}{PARA 11 "" 1 "" {XPPMATH 20 "<$\"\"\"\"
\"$" }}{PARA 11 "" 1 "" {XPPMATH 20 "<$\"\"\"\"\"%" }}{PARA 11 "" 1 ""
 {XPPMATH 20 "<$\"\"#\"\"$" }}{PARA 11 "" 1 "" {XPPMATH 20 "<$\"\"#\"
\"%" }}{PARA 11 "" 1 "" {XPPMATH 20 "<$\"\"$\"\"%" }}}{EXCHG {PARA 0 "
" 0 "" {TEXT 440 50 "Of course, we may do other things other than just
 " }{TEXT 299 12 "print(\{i,j\})" }{TEXT 440 187 ". We can take i,j an
d perform various other operations. For example, here we form the set \+
of all sums of i and j  where i < j and put them in a set called S whe
n i + j  is a prime number " }{TEXT 300 3 "and" }{TEXT 440 94 " we cou
nt the number of times that i + j is a prime. For this we need a \"cou
nter\". We call it " }{TEXT 301 5 "count" }{TEXT 440 27 ". It could be
 any variable." }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "" 
{TEXT 440 55 "We set printlevel to 2 so we can see what is going on. "
 }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 14 "printlevel:=2;" }}{PARA 
11 "" 1 "" {XPPMATH 20 ">I+printlevelG6\"\"\"#" }}}{EXCHG {PARA 0 "> "
 0 "" {MPLTEXT 1 0 7 "S:=\{\}:\n" }{MPLTEXT 1 0 10 "count:=0:\n" }
{MPLTEXT 1 0 21 "for i from 1 to 4 do\n" }{MPLTEXT 1 0 26 "   for j fr
om i+1 to 4 do\n" }{MPLTEXT 1 0 33 "     print(`-----------------`);\n
" }{MPLTEXT 1 0 17 "     print(i,j);\n" }{MPLTEXT 1 0 13 "     n:=i+j;
\n" }{MPLTEXT 1 0 24 "     if isprime(n) then\n" }{MPLTEXT 1 0 29 "   \+
    print(`prime found`);\n" }{MPLTEXT 1 0 23 "       count:=count+1;
\n" }{MPLTEXT 1 0 33 "       print(`count = `,count); \n" }{MPLTEXT 1 
0 23 "       S:=S union \{n\};\n" }{MPLTEXT 1 0 29 "       print(`S = \+
`,S);     \n" }{MPLTEXT 1 0 13 "     end if;\n" }{MPLTEXT 1 0 11 "   e
nd do;\n" }{MPLTEXT 1 0 8 "end do;\n" }{MPLTEXT 1 0 21 "print(`-------
---`);\n" }{MPLTEXT 1 0 34 "print(`S = `,S, `count = `,count);" }}
