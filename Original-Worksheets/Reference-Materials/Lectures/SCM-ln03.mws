ctedG" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 55 "Note that we can get th
ese on the same line as follows:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT
 1 0 63 "is_increasing(1,2,3),is_increasing(1,2,1),is_increasing(1,1,1
);" }}{PARA 11 "" 1 "" {XPPMATH 20 "6%I%trueG%*protectedGI&falseGF$F%"
 }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 45 "Here's another example of a B
oolean function." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 22 "is_comp
osite:=proc(n)\n" }{MPLTEXT 1 0 38 "  if n < 2 then return false; end \+
if;\n" }{MPLTEXT 1 0 44 "  if isprime(n) = false then return true;  \n
" }{MPLTEXT 1 0 24 "    else return false; \n" }{MPLTEXT 1 0 10 "  end
 if;\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 50 "is_composite(1),is_composite(11),is_composite(10);" }
}{PARA 11 "" 1 "" {XPPMATH 20 "6%I&falseG%*protectedGF#I%trueGF$" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 440 24 "Note that the statement " }{TEXT 
262 16 "isprime(n)=false" }{TEXT 440 34 " may be replaced by the state
ment " }{TEXT 263 15 "not(isprime(n))" }{TEXT 440 49 " in fact the pro
cedure may be written as follows:" }{MPLTEXT 1 0 1 " " }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 23 "is_composite2:=proc(n)\n" }{MPLTEXT
 1 0 38 "  if n < 2 then return false; end if;\n" }{MPLTEXT 1 0 26 "  \+
return not(isprime(n));\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG 
