, is_composite2(10);" }}{PARA 11 "" 1 "" {XPPMATH 20 "6%I&falseG%*prot
ectedGF#I%trueGF$" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}}
