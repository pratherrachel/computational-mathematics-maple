{SECT 0 {EXCHG {PARA 211 "" 0 "" {TEXT 438 48 "Lecture 3 More Flow Co
ntrol, Variables and Names" }}}{SECT 0 {PARA 3 "" 0 "" {TEXT 439 50 "i
f ... then ... elif ... then ... else ... end if;" }}{PARA 0 "" 0 "" 
{TEXT 440 0 "" }}{EXCHG {PARA 209 "" 0 "" {TEXT 207 49 "Such statement
s  take one of the following forms:" }{TEXT 441 1 "\n" }{TEXT 441 1 "
\n" }{TEXT 207 2 "if" }{TEXT 441 1 " " }{TEXT 207 18 "Boolean expressi
on" }{TEXT 441 1 " " }{TEXT 207 4 "then" }{TEXT 441 2 " \n" }{TEXT 
441 5 "     " }{TEXT 207 22 "sequence of statements" }}{PARA 212 "" 0 
"" {TEXT 207 8 "end if;\n" }}{PARA 209 "" 0 "" {TEXT 441 38 "---------
-----------------------------" }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}
{PARA 0 "" 0 "" {TEXT 212 2 "if" }{TEXT 440 21 " Boolean expression  "
 }{TEXT 213 4 "then" }{TEXT 440 2 " \n" }{TEXT 440 25 "  sequence of s
tatements\n" }{TEXT 214 4 "else" }}{PARA 0 "" 0 "" {TEXT 440 24 " sequ
ence of statements\n" }{TEXT 215 7 "end if;" }{TEXT 440 1 "\n" }}
{PARA 0 "" 0 "" {TEXT 440 38 "--------------------------------------" 
}}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "" {TEXT 216 2 "if" }
{TEXT 440 24 "   Boolean expression1  " }{TEXT 217 4 "then" }{TEXT 
440 2 " \n" }{TEXT 440 25 "  sequence of statements\n" }{TEXT 218 4 "e
lif" }{TEXT 440 21 " Boolean expression2 " }{TEXT 219 4 "then" }}
{PARA 0 "" 0 "" {TEXT 440 23 " sequence of statements" }}{PARA 0 "" 0 
"" {TEXT 440 0 "" }}{PARA 0 "" 0 "" {TEXT 440 4 "    " }{TEXT 220 6 ".
 . . " }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "" {TEXT 221 4 
"elif" }{TEXT 440 21 " Boolean expressionN " }{TEXT 222 4 "then" }
{TEXT 440 1 "\n" }{TEXT 440 24 " sequence of statements\n" }{TEXT 223 
4 "else" }{TEXT 440 1 "\n" }{TEXT 440 25 "  sequence of statements\n" 
}{TEXT 224 7 "end if;" }}{PARA 0 "" 0 "" {TEXT 440 38 "---------------
-----------------------" }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 ""
 0 "" {TEXT 440 3 "By " }{TEXT 225 18 "Boolean expression" }{TEXT 440 
36 " we mean a statement that is either " }{TEXT 226 4 "true" }{TEXT 
440 4 " or " }{TEXT 227 5 "false" }{TEXT 440 52 ". (Note: Maple's Bool
ean expressions have the value " }{TEXT 228 4 "true" }{TEXT 440 4 " or
 " }{TEXT 229 5 "false" }{TEXT 440 8 " and not" }{TEXT 230 5 " True" }
{TEXT 440 4 " or " }{TEXT 231 5 "False" }{TEXT 440 49 ".) Such stateme
nts are usually constructed using " }{TEXT 232 18 "<, <=, >, >=, <>. "
 }{TEXT 440 3 "or " }{TEXT 233 1 "=" }{TEXT 440 46 " together possibly
 with the logical operators " }{TEXT 234 12 "and, or, not" }{TEXT 440 
2 ". " }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "" {TEXT 440 6 
"Note  " }{XPPEDIT 18 0 "Typesetting:-mrow(Typesetting:-mi(\"\"), Type
setting:-mrow(Typesetting:-mi(\"x\", italic = \"true\", mathvariant = \+
\"italic\"), Typesetting:-mo(\"&ne;\", mathvariant = \"normal\", fence
 = \"false\", separator = \"false\", stretchy = \"false\", symmetric =
 \"false\", largeop = \"false\", movablelimits = \"false\", accent = \+
\"false\", lspace = \"0.2777778em\", rspace = \"0.2777778em\"), Typese
tting:-mi(\"y\", italic = \"true\", mathvariant = \"italic\")), Typese
tting:-mi(\"\"));" "-I%mrowG6#/I+modulenameG6\"I,TypesettingGI(_syslib
GF'6%-I#miGF$6#Q!F'-F#6%-F,6%Q\"xF'/%'italicGQ%trueF'/%,mathvariantGQ'
italicF'-I#moGF$6-Q%&ne;F'/F8Q'normalF'/%&fenceGQ&falseF'/%*separatorG
FB/%)stretchyGFB/%*symmetricGFB/%(largeopGFB/%.movablelimitsGFB/%'acce
ntGFB/%'lspaceGQ,0.2777778emF'/%'rspaceGFQ-F,6%Q\"yF'F4F7F+" }{TEXT 
440 32 " is denoted by x <> y in Maple. " }}{PARA 0 "" 0 "" {TEXT 440 
0 "" }}{PARA 0 "" 0 "" {TEXT 440 73 "Other types of Boolean expression
s are formed by procedures which return " }{TEXT 235 4 "true" }{TEXT 
440 4 " or " }{TEXT 236 5 "false" }{TEXT 440 17 ". And example is " }
{TEXT 237 10 "isprime(n)" }{TEXT 440 43 ". For specific values of n, t
his is either " }{TEXT 238 4 "true" }{TEXT 440 4 " or " }{TEXT 239 5 "
false" }{TEXT 440 3 ". \n" }}{PARA 0 "" 0 "" {TEXT 440 55 "One can tes
t a Boolean expression by using the command " }{TEXT 240 5 "evalb" }
{TEXT 440 30 " as in the following examples:" }}{PARA 0 "" 0 "" {TEXT 
440 0 "" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 4 "1<2;" }}{PARA 11 
"" 1 "" {XPPMATH 20 "2\"\"\"\"\"#" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 11 "evalb(1<2);" }}{PARA 11 "" 1 "" {XPPMATH 20 "I%trueG%
*protectedG" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "evalb(2<1);"
 }}{PARA 11 "" 1 "" {XPPMATH 20 "I&falseG%*protectedG" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 12 "evalb(z<w);\n" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "2I\"zG6\"I\"wGF$" }}}{PARA 0 "" 0 "" {TEXT 440 74 "   Thi
s indicates that Maple doesn't know whether z < w is true or false. " 
}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "" {TEXT 440 2 
"A " }{TEXT 241 10 "statement " }{TEXT 440 80 "is a command followed b
y a colon or semicolon. The following is an example of a " }{TEXT 242 
22 "sequence of statements" }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0
 "" 0 "" {TEXT 440 1 " " }{TEXT 243 10 "  y:=i^2;\n" }{TEXT 244 11 "  \+
 z:=i^3;\n" }{TEXT 245 15 "   print(y,z);\n" }{TEXT 246 1 "\n" }{TEXT 
440 75 "So far as Maple is concerned they could be all on the same lin
e as follows:" }{TEXT 247 1 "\n" }{TEXT 248 1 "\n" }{TEXT 249 31 "  y:
=i^2;  z:=i^3;  print(y,z);" }}{PARA 0 "" 0 "" {TEXT 440 1 "\n" }{TEXT
 440 106 "We now look at some examples. The first illustrates a common
 error. Execute the commands to see the error." }}{PARA 0 "" 0 "" 
{TEXT 440 0 "" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "restart:" }
}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 15 "if t > 1 then \n" }
{MPLTEXT 1 0 9 "  x:=3; \n" }{MPLTEXT 1 0 8 "end if; " }}{PARA 207 "" 
1 "" {TEXT 442 0 "" }{HYPERLNK 442 "Error, cannot determine if this ex
pression is true or false: 1 < t" 4 "http://www.maplesoft.com/support/
help/errors/view.aspx?path=Error,%20cannot%20determine%20if%20this%20e
xpression%20is%20true%20or%20false%3A%201%20%3C%20t" "" }{TEXT 442 0 "
" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 34 "The expression t  > 1 is cal
led a " }{TEXT 250 18 "Boolean expression" }{TEXT 440 222 ".  The prob
lem here is that Maple does not know the value of t so it cannot tell \+
if t > 1 is true  or false.  This can be fixed by putting in a value o
f t as we now do. Note that a print statement is not needed if we use \+
\"" }{TEXT 251 7 "end if;" }{TEXT 440 2 "\"," }{TEXT 252 1 " " }{TEXT 
440 16 " as opposed to \"" }{TEXT 253 7 "end if:" }{TEXT 440 2 "\"." }
}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 0 "" }}}{EXCHG {PARA 0 "" 0 "" 
{TEXT 440 30 " Try to anticipate the output." }}}{EXCHG {PARA 0 "> " 0
 "" {MPLTEXT 1 0 6 "t:=3:\n" }{MPLTEXT 1 0 15 "if t > 1 then \n" }
{MPLTEXT 1 0 8 "  x:=2;\n" }{MPLTEXT 1 0 12 "  print(x);\n" }{MPLTEXT 
1 0 7 "end if:" }}{PARA 11 "" 1 "" {XPPMATH 20 "\"\"#" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 6 "t:=3:\n" }{MPLTEXT 1 0 15 "if t > 1 \+
then \n" }{MPLTEXT 1 0 8 "  x:=2;\n" }{MPLTEXT 1 0 7 "end if;" }}
{PARA 11 "" 1 "" {XPPMATH 20 ">I\"xG6\"\"\"#" }}}{EXCHG {PARA 0 "> " 0
 "" {MPLTEXT 1 0 6 "t:=0:\n" }{MPLTEXT 1 0 15 "if t > 1 then \n" }
{MPLTEXT 1 0 10 "   x:=2; \n" }{MPLTEXT 1 0 8 "end if; " }}}{EXCHG 
{PARA 0 "" 0 "" {TEXT 440 0 "" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 
0 6 "t:=0:\n" }{MPLTEXT 1 0 15 "if t > 1 then \n" }{MPLTEXT 1 0 9 "  x
:=2; \n" }{MPLTEXT 1 0 8 "end if;\n" }{MPLTEXT 1 0 6 "x:=3; " }}{PARA 
11 "" 1 "" {XPPMATH 20 ">I\"xG6\"\"\"$" }}}{EXCHG {PARA 0 "" 0 "" 
{TEXT 440 49 "The above can be accomplished with the following:" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 6 "t:=0:\n" }{MPLTEXT 1 0 15 "if
 t > 1 then \n" }{MPLTEXT 1 0 9 "  x:=2; \n" }{MPLTEXT 1 0 5 "else\n" 
}{MPLTEXT 1 0 8 "  x:=3;\n" }{MPLTEXT 1 0 7 "end if;" }}{PARA 11 "" 1 
"" {XPPMATH 20 ">I\"xG6\"\"\"$" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 
23 "Here we illustrate the " }{TEXT 254 52 "if .. then .. elif .. then
 else... fi  construction." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 
11 "f:=proc(y)\n" }{MPLTEXT 1 0 27 "  if y <= 1 then return 1;\n" }
{MPLTEXT 1 0 31 "    elif y <= 2 then return 2;\n" }{MPLTEXT 1 0 31 " \+
   elif y <= 3 then return 3;\n" }{MPLTEXT 1 0 31 "    elif y <= 4 the
n return 4;\n" }{MPLTEXT 1 0 26 "    else return infinity;\n" }
{MPLTEXT 1 0 10 "  end if;\n" }{MPLTEXT 1 0 10 "end proc:\n" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 440 109 "Note that a procedure returns on
ly one value. When a value is returned the rest of the procedure is sk
ipped.\n" }{TEXT 440 67 "The same result can be accomplished with the \+
following procedure.:\n" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "
g:=proc(y)\n" }{MPLTEXT 1 0 35 "  if y <= 1 then return 1; end if;\n" 
}{MPLTEXT 1 0 35 "  if y <= 2 then return 2; end if;\n" }{MPLTEXT 1 0 
35 "  if y <= 3 then return 3; end if;\n" }{MPLTEXT 1 0 36 "  if y <= \+
4 then return 4; end if; \n" }{MPLTEXT 1 0 20 "  return infinity; \n" 
}{MPLTEXT 1 0 9 "end proc:" }{TEXT 440 7 "or end:" }}}{EXCHG {PARA 0 "
" 0 "" {TEXT 440 56 "We check a few values of x to see that f(x) = g(x
): The " }{TEXT 255 5 "by .5" }{TEXT 440 36 " in the do loop causes in
crements of" }{TEXT 256 3 " .5" }{TEXT 440 26 " instead of the default
 by" }{TEXT 257 2 " 1" }{TEXT 440 1 "." }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 28 "for x from 0 to 5 by .5 do \n" }{MPLTEXT 1 0 61 "  pr
int(`If x = `,x,` then  f(x) = `,f(x),` g(x) = `,g(x)); \n" }{MPLTEXT 
1 0 7 "end do;" }}{PARA 11 "" 1 "" {XPPMATH 20 "6(I(If~x~=~G6\"\"\"!I/
~then~~f(x)~=~GF$\"\"\"I)~g(x)~=~GF$F'" }}{PARA 11 "" 1 "" {XPPMATH 20
 "6(I(If~x~=~G6\"$\"\"&!\"\"I/~then~~f(x)~=~GF$\"\"\"I)~g(x)~=~GF$F)" 
}}{PARA 11 "" 1 "" {XPPMATH 20 "6(I(If~x~=~G6\"$\"#5!\"\"I/~then~~f(x)
~=~GF$\"\"\"I)~g(x)~=~GF$F)" }}{PARA 11 "" 1 "" {XPPMATH 20 "6(I(If~x~
=~G6\"$\"#:!\"\"I/~then~~f(x)~=~GF$\"\"#I)~g(x)~=~GF$F)" }}{PARA 11 ""
 1 "" {XPPMATH 20 "6(I(If~x~=~G6\"$\"#?!\"\"I/~then~~f(x)~=~GF$\"\"#I)
~g(x)~=~GF$F)" }}{PARA 11 "" 1 "" {XPPMATH 20 "6(I(If~x~=~G6\"$\"#D!\"
\"I/~then~~f(x)~=~GF$\"\"$I)~g(x)~=~GF$F)" }}{PARA 11 "" 1 "" 
