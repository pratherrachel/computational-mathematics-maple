{EXCHG {PARA 0 "" 0 "" {TEXT 440 65 "More examples: We create a Boolea
n valued function which we call " }{TEXT 261 13 "is_increasing" }{TEXT
 440 1 "." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 27 "is_increasing:
=proc(a,b,c)\n" }{MPLTEXT 1 0 36 "  if a<b and b<c then return true; \+
\n" }{MPLTEXT 1 0 23 "    else return false;\n" }{MPLTEXT 1 0 10 "  en
d if;\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 22 "is_increasing(1,2,3);\n" }{MPLTEXT 1 0 22 "is_increas
ing(1,2,1);\n" }{MPLTEXT 1 0 21 "is_increasing(1,1,1);" }}{PARA 11 "" 
