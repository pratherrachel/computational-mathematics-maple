(n)\n" }{MPLTEXT 1 0 20 "  local x, y, Sols;\n" }{MPLTEXT 1 0 12 "  So
ls:=\{\};\n" }{MPLTEXT 1 0 38 "  for x from 1 to evalf(sqrt(n/2)) do\n
" }{MPLTEXT 1 0 23 "    y:= root(n-x^2,2);\n" }{MPLTEXT 1 0 29 "    if
 type(y,posint) then  \n" }{MPLTEXT 1 0 33 "      Sols:=Sols union \{
\{x,y\}\}; \n" }{MPLTEXT 1 0 12 "    end if;\n" }{MPLTEXT 1 0 10 "  en
d do;\n" }{MPLTEXT 1 0 15 "  return Sols;\n" }{MPLTEXT 1 0 10 "end pro
c: " }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 1 "\n" }{TEXT 440 33 "What ha
ppens if we leave off the " }{TEXT 369 5 "evalf" }{TEXT 440 21 " in th
