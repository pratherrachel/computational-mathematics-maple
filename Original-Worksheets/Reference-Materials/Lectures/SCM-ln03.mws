440 0 "" }}{PARA 0 "" 0 "" {TEXT 440 54 "Why is count = 4, yet S only \+
contains three elements?\n" }{TEXT 440 1 "\n" }{TEXT 440 143 "Later we
 will show how to get rid of unwanted commas such as the commas in the
 last output statement S = , \{ 3,5,7\}, count = , 4 by use of the " }
{TEXT 302 6 "printf" }{TEXT 440 18 " comma instead of " }{TEXT 303 5 "
print" }{TEXT 440 2 ".\n" }{TEXT 440 1 "\n" }{TEXT 440 140 "We can hav
e do loops nested three levels deep as in the following example where \+
we form the set of all binary sequences [lists] of length 3:" }}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "restart;" }}}{EXCHG {PARA 0 "
" 0 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "" {TEXT 440 64 "Note that the pr
int statement in the following program has been " }{TEXT 304 13 "comme
nted out" }{TEXT 440 69 " by use of #. Try removing the # and seeing t
he difference in output." }}}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 7 "S:=\{\}:\n" }{MPLTEXT 1 0 22 "for x1
 from 0 to 1 do\n" }{MPLTEXT 1 0 24 "  for x2 from 0 to 1 do\n" }
{MPLTEXT 1 0 25 "   for x3 from 0 to 1 do\n" }{MPLTEXT 1 0 23 "     #p
rint(x1,x2,x3);\n" }{MPLTEXT 1 0 32 "     S:=S union \{ [x1,x2,x3] \};
\n" }{MPLTEXT 1 0 11 "   end do:\n" }{MPLTEXT 1 0 10 "  end do:\n" }
{MPLTEXT 1 0 8 "end do:\n" }{MPLTEXT 1 0 2 "S;" }}}{EXCHG {PARA 0 "" 0
 "" {TEXT 440 198 "We will learn other ways to define this set later. \+
Clearly you would not want to use this method to produce the set of al
l 1024 binary sequences of length 10. That would require 10 nested do \+
loops. " }}}}{SECT 0 {PARA 3 "" 0 "" {TEXT 439 26 "Local and global va
riables" }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{EXCHG {PARA 0 "" 0 "" 
{TEXT 305 10 "A variable" }{TEXT 440 257 " represents a data item stor
ed in the computer memory, such as a numerical value or a character st
ring, that can change its value during the execution of a program. Thi
s section describes local variables, global variables, and their use i
n Maple procedures." }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "
" {TEXT 306 15 "Local variables" }{TEXT 440 29 " are variables that ar
e used " }{TEXT 307 6 "inside" }{TEXT 440 99 " a procedure. After the \+
procedure is executed the local variables revert to their original val
ues. " }{TEXT 308 16 "Global variables" }{TEXT 440 121 " may be change
d inside the procedure and the values will be retained after the proce
dure is over. Here are some examples:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 8 "restart:" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 97 "We f
irst set the value of each of the four variables x1,x2,y1,y2 to 1 by e
xecuting the following:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 26 "
(x1,x2,y1,y2):=(1,1,1,1);\n" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 89 "N
ow we define a simple procedure called f: Take a minute to try to gues
s what it will do:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "f:=pr
oc(n)\n" }{MPLTEXT 1 0 16 "  global x1,x2;\n" }{MPLTEXT 1 0 15 "  loca
l y1,y2;\n" }{MPLTEXT 1 0 9 "  x1:=2:\n" }{MPLTEXT 1 0 9 "  x2:=3:\n" 
}{MPLTEXT 1 0 9 "  y1:=5:\n" }{MPLTEXT 1 0 9 "  y2:=7:\n" }{MPLTEXT 1 
0 24 "  return n*x1*x2*y1*y2;\n" }{MPLTEXT 1 0 10 "end proc:\n" }}}
{EXCHG {PARA 0 "" 0 "" {TEXT 440 29 "Let's see what f(11) returns:" }}
}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 7 "f(11);\n" }}}{EXCHG {PARA 0 
"" 0 "" {TEXT 440 36 "It will help to factor this integer:" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "ifactor(%);" }}}{EXCHG {PARA 0 "" 0
 "" {TEXT 440 45 "Now let's see what happened to the variables " }
{TEXT 309 14 "x1, x2, y1, y2" }{TEXT 440 1 ":" }}}{EXCHG {PARA 0 "> " 
0 "" {MPLTEXT 1 0 12 "x1,x2,y1,y2;" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 
440 151 "You can see that the global variables retain the changes made
 inside the procedure f, but the local variables are unchanged by what
 happened inside f. " }{TEXT 310 50 "I recommend using global variable
s very sparingly." }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 
"" 0 "" {TEXT 440 118 "Here are two simple examples. Execute these com
mands in order. Try to anticipate what the output will be in each case
." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "restart;" }}}{EXCHG 
{PARA 0 "" 0 "" {TEXT 440 159 "Note that a procedure may have no input
. But to execute it one still needs a pair of parentheses.  Note that \+
we use NULL as output. NULL is the empty sequence." }}}{EXCHG {PARA 0 
"> " 0 "" {MPLTEXT 1 0 11 "f2:=proc()\n" }{MPLTEXT 1 0 12 "  global x;
\n" }{MPLTEXT 1 0 10 "  x:=2*x;\n" }{MPLTEXT 1 0 15 "  return NULL;\n"
 }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 
11 "f3:=proc()\n" }{MPLTEXT 1 0 12 "  global x;\n" }{MPLTEXT 1 0 10 " \+
 x:=3*x;\n" }{MPLTEXT 1 0 15 "  return NULL;\n" }{MPLTEXT 1 0 9 "end p
roc:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 5 "x:=2;" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 5 "f2();" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 2 "x;" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 5 "f3();"
 }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 2 "x;" }}}}{SECT 0 {PARA 3 "
" 0 "" {TEXT 439 33 "print vs return inside procedures" }}{PARA 0 "" 0
 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "" {TEXT 440 69 "It is very importan
t that you know the difference between the use of " }{TEXT 311 5 "prin
t" }{TEXT 440 5 " and " }{TEXT 312 6 "return" }{TEXT 440 116 " when us
ed inside procedures. Note that return can only be used inside a proce
dure, but print can be used elsewhere." }}{PARA 0 "" 0 "" {TEXT 440 0 
"" }}{EXCHG {PARA 0 "" 0 "" {TEXT 440 50 "Consider carefully the follo
wing procedures named " }{TEXT 313 6 "gprint" }{TEXT 440 5 " and " }
{TEXT 314 7 "greturn" }{TEXT 440 25 ": Notice that the output " }{TEXT
 315 5 "seems" }{TEXT 440 60 " to be the same for each. However, see b
elow for differences" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "rest
art;" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 16 "gprint:=proc(x)\n" 
}{MPLTEXT 1 0 11 "  local y;\n" }{MPLTEXT 1 0 10 "  y:=2*x;\n" }
{MPLTEXT 1 0 12 "  print(y);\n" }{MPLTEXT 1 0 10 "end proc:\n" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 17 "greturn:=proc(x)\n" }
{MPLTEXT 1 0 11 "  local y;\n" }{MPLTEXT 1 0 10 "  y:=2*x;\n" }
{MPLTEXT 1 0 12 "  return y;\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 10 "gprint(3);" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "\"\"'" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "gretu
rn(3);" }}{PARA 11 "" 1 "" {XPPMATH 20 "\"\"'" }}}{EXCHG {PARA 0 "" 0 
"" {TEXT 440 13 "But note how " }{TEXT 316 6 "gprint" }{TEXT 440 38 " \+
misbehaves in the following examples:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 13 "y:=gprint(3);" }}{PARA 11 "" 1 "" {XPPMATH 20 "\"\"'"
 }}{PARA 11 "" 1 "" {XPPMATH 20 ">I\"yG6\"F$" }}}{EXCHG {PARA 0 "> " 0
 "" {MPLTEXT 1 0 12 "2+gprint(3);" }}{PARA 11 "" 1 "" {XPPMATH 20 "\"
\"'" }}{PARA 11 "" 1 "" {XPPMATH 20 ",&\"\"#\"\"\"6\"F$" }}}{EXCHG 
{PARA 0 "" 0 "" {TEXT 440 4 "But " }{TEXT 317 7 "greturn" }{TEXT 440 
26 " behaves as we would wish:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 
1 0 14 "y:=greturn(3);" }}{PARA 11 "" 1 "" {XPPMATH 20 ">I\"yG6\"\"\"'
" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 13 "2+greturn(3);" }}{PARA 
11 "" 1 "" {XPPMATH 20 "\"\")" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 41 
"The moral of this section is: DO NOT USE " }{TEXT 318 5 "print" }
{TEXT 440 13 " INSTEAD OF  " }{TEXT 319 6 "return" }{TEXT 440 109 " WH
EN CONSTRUCTING A PROCEDURE. The appropriate use of print in procedure
s is explained in the next section. " }}}}{SECT 0 {PARA 3 "" 0 "" 
{TEXT 439 57 "Use of print, debug, undebug and printlevel for debuggin
g" }}{EXCHG {PARA 0 "" 0 "" {TEXT 440 56 "Consider the following attem
pt to construct a procedure " }{TEXT 320 6 "binexp" }{TEXT 440 63 " wh
ose input is n and whose output is the smallest k such that " }
