 "\"\"!" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 29 "We now illustrate the
 use of " }{TEXT 264 5 "break" }{TEXT 440 91 " in a loop. This program
 will find the smallest integer w between 1 and 100 that satisfies " }
{XPPEDIT 18 0 "Typesetting:-mrow(Typesetting:-mi(\"\"), Typesetting:-m
row(Typesetting:-mi(\"\"), Typesetting:-mrow(Typesetting:-msup(Typeset
ting:-mn(\"10\", mathvariant = \"normal\"), Typesetting:-mn(\"6\", mat
hvariant = \"normal\"), superscriptshift = \"0\")), Typesetting:-mo(\"
<\", mathvariant = \"normal\", fence = \"false\", separator = \"false
\", stretchy = \"false\", symmetric = \"false\", largeop = \"false\", \+
movablelimits = \"false\", accent = \"false\", lspace = \"0.2777778em
\", rspace = \"0.2777778em\"), Typesetting:-msup(Typesetting:-mn(\"2\"
, mathvariant = \"normal\"), Typesetting:-mi(\"w\", italic = \"true\",
 mathvariant = \"italic\"), superscriptshift = \"0\")), Typesetting:-m
i(\"\"));" "-I%mrowG6#/I+modulenameG6\"I,TypesettingGI(_syslibGF'6%-I#
miGF$6#Q!F'-F#6&F+-F#6#-I%msupGF$6%-I#mnGF$6$Q#10F'/%,mathvariantGQ'no
rmalF'-F76$Q\"6F'F:/%1superscriptshiftGQ\"0F'-I#moGF$6-Q\"<F'F:/%&fenc
eGQ&falseF'/%*separatorGFI/%)stretchyGFI/%*symmetricGFI/%(largeopGFI/%
.movablelimitsGFI/%'accentGFI/%'lspaceGQ,0.2777778emF'/%'rspaceGFX-F46
%-F76$Q\"2F'F:-F,6%Q\"wF'/%'italicGQ%trueF'/F;Q'italicF'F@F+" }{TEXT 
440 1 ":" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 23 "for w from 1 to
 100 do\n" }{MPLTEXT 1 0 21 "  if 2^w > 10^6 then\n" }{MPLTEXT 1 0 19 
"    print(w, 2^w);\n" }{MPLTEXT 1 0 11 "    break;\n" }{MPLTEXT 1 0 
10 "  end if;\n" }{MPLTEXT 1 0 8 "end do;\n" }{MPLTEXT 1 0 39 "print(`
We are finished! and `,'w'=w );\n" }}{PARA 11 "" 1 "" {XPPMATH 20 "6$
\"#?\"(w&[5" }}{PARA 11 "" 1 "" {XPPMATH 20 "6$I6We~are~finished!~and~
G6\"/I\"wGF$\"#?" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 10 "Note that " 
}{TEXT 265 5 "break" }{TEXT 440 64 " means to get out of the loop and \+
go to the statement following " }{TEXT 266 6 "end do" }{TEXT 440 2 ". 
" }{TEXT 267 5 "When " }{TEXT 268 5 "break" }{TEXT 269 82 " is execute
d the value of the index w is the value at the time the loop is exited
." }{TEXT 440 59 " Note that the same result is obtained if we leave o
ut the " }{TEXT 270 6 "to 100" }{TEXT 440 101 " on the first line. Thi
s may be useful if we don't know how far to search for the desired val
ue of w." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 16 "for w from 1 do
\n" }{MPLTEXT 1 0 21 "  if 2^w > 10^6 then\n" }{MPLTEXT 1 0 19 "    pr
int(w, 2^w);\n" }{MPLTEXT 1 0 11 "    break;\n" }{MPLTEXT 1 0 10 "  en
d if;\n" }{MPLTEXT 1 0 8 "end do;\n" }{MPLTEXT 1 0 39 "print(`We are f
inished! and `,'w'=w );\n" }}{PARA 11 "" 1 "" {XPPMATH 20 "6$\"#?\"(w&
[5" }}{PARA 11 "" 1 "" {XPPMATH 20 "6$I6We~are~finished!~and~G6\"/I\"w
GF$\"#?" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 440 95 "Let's write a program
 to find the product of all primes less than 100: Try this program wit
h a " }{TEXT 271 9 "semicolon" }{TEXT 440 7 " after " }{TEXT 272 6 "en
d do" }{TEXT 440 15 " rather than a " }{TEXT 273 5 "colon" }{TEXT 440 
44 ". Now see if you can guess what the command " }{TEXT 274 4 "next" 
}{TEXT 440 6 " does." }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 6 "P:=1
:\n" }{MPLTEXT 1 0 23 "for m from 1 to 100 do\n" }{MPLTEXT 1 0 30 "  i
f isprime(m) = false then \n" }{MPLTEXT 1 0 11 "    next; \n" }
{MPLTEXT 1 0 10 "  end if;\n" }{MPLTEXT 1 0 13 "  P:= P * m;\n" }
{MPLTEXT 1 0 8 "end do:\n" }{MPLTEXT 1 0 3 "P; " }}{PARA 11 "" 1 "" 
{XPPMATH 20 "\"FqgvJt9-JvC%=b%R'zc0B" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 
440 10 "Note that " }{TEXT 275 5 "next " }{TEXT 440 38 " means to go t
o the next value of the " }{TEXT 276 5 "index" }{TEXT 440 25 " - in th
e above case the " }{TEXT 277 5 "index" }{TEXT 440 4 " is " }{TEXT 
278 1 "m" }{TEXT 440 25 " - if m is not prime. If " }{TEXT 279 4 "next
" }{TEXT 440 53 " is executed then the commands in the loop following 
" }{TEXT 280 3 "nex" }{TEXT 440 103 "t will be skipped over. In this p
rogram, if  m is prime we replace P by the current value of P times m.
" }}{PARA 0 "" 0 "" {TEXT 440 0 "" }}{PARA 0 "" 0 "" {TEXT 440 75 "In \+
the following example we seek the smallest positive integer n such tha
t " }{XPPEDIT 18 0 "Typesetting:-mrow(Typesetting:-mi(\"\"), Typesetti
