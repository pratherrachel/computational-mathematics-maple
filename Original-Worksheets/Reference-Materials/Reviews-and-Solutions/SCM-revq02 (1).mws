{MPLTEXT 1 0 24 " for k from 2 to n-1 do\n" }{MPLTEXT 1 0 43 " if n mo
d k = 0 then return false end if: \n" }{MPLTEXT 1 0 9 " end do:\n" }
{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG {PARA 258 "> " 0 "" {MPLTEXT 1 0 
13 "ISPRIME(101);" }}}{EXCHG {PARA 259 "" 0 "" {TEXT 207 56 "The proce
dure is not complete. The correct procedure is:" }}}{EXCHG {PARA 260 "
> " 0 "" {MPLTEXT 1 0 133 "ISPRIME:=proc(n)\n  local k;\n  for k from \+
2 to n-1 do\n    if n mod k = 0 then return false; end if;\n  end do:
\n  return true;\nend proc:" }}}{EXCHG {PARA 261 "> " 0 "" {MPLTEXT 1 
0 25 "ISPRIME(10); ISPRIME(11);" }}{PARA 262 "" 1 "" {TEXT 215 5 "fals
e" }{TEXT 215 5 "\ntrue" }}}{EXCHG {PARA 263 "" 0 "" {TEXT 214 0 "" }}
