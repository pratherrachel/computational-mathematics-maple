" }{MPLTEXT 1 0 9 " SUM:=0:\n" }{MPLTEXT 1 0 22 " for k from 1 to n do
\n" }{MPLTEXT 1 0 45 " if isprime(k)=true then SUM:=SUM+k end if: \n" 
}{MPLTEXT 1 0 9 " end do;\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG 
{PARA 274 "> " 0 "" {MPLTEXT 1 0 8 "SUM(10);" }}}{EXCHG {PARA 275 "" 0
 "" {TEXT 207 30 "The correct program should be:" }}}{EXCHG {PARA 276 
"> " 0 "" {MPLTEXT 1 0 149 "SUM:= proc(n)\n  local SUM, k;\n  SUM:= 0:
