}}{PARA 0 "" 0 "" {TEXT 226 0 "" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 208 
10 "Solution: " }{TEXT 222 0 "" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 
1 0 14 "Koch:=proc(n::" }{MPLTEXT 1 0 9 "nonnegint" }{MPLTEXT 1 0 2 ")
\n" }{MPLTEXT 1 0 17 "if n=0 then 'F';\n" }{MPLTEXT 1 0 72 " else cat(
 Koch(n-1), 'L', Koch(n-1), 'RR', Koch(n-1), 'L', Koch(n-1));\n" }
{MPLTEXT 1 0 8 "end if;\n" }{MPLTEXT 1 0 9 "end proc:" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "Koch(1);" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "I)FLFRRFLFG6\"" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 226 0 "" 
}}{PARA 0 "" 0 "" {TEXT 226 136 "8. Write a procedure that given a num
ber a, a function f and a positive integer n will compute the term x[n
] in the sequence defined by\n" }{TEXT 226 40 "        x[0]= a  and   \+
x[i]:= f(x[i-1])\n" }{TEXT 226 180 "if i is a positive integer. Do thi
s WITHOUT using an indexed variable x[i]. I only use this to indicate \+
mathematically what I am describing. There are at least two ways to do
 this." }}{PARA 0 "" 0 "" {TEXT 226 0 "" }}}{EXCHG {PARA 0 "" 0 "" 
{TEXT 208 10 "Solution: " }{TEXT 223 0 "" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 9 "restart;\n" }{MPLTEXT 1 0 22 "method:=proc(b, f, n)\n"
 }{MPLTEXT 1 0 17 "  if n=0 then b;\n" }{MPLTEXT 1 0 20 "    else (f@@
n)(b);\n" }{MPLTEXT 1 0 8 "end if;\n" }{MPLTEXT 1 0 9 "end proc:" }}}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 27 "method(3, x->2*x mod 3, 7);"
 }}{PARA 11 "" 1 "" {XPPMATH 20 "\"\"!" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 9 "restart;\n" }{MPLTEXT 1 0 21 "method2:=proc(b,f,n)\n" 
}{MPLTEXT 1 0 13 "  local x,i;\n" }{MPLTEXT 1 0 2 "  " }}}{EXCHG 
{PARA 0 "" 0 "" {TEXT 226 0 "" }}{PARA 0 "" 0 "" {TEXT 226 68 "9. Writ
e a recursive procedure to compute the n-th Fibonacci number." }}
{PARA 0 "" 0 "" {TEXT 226 0 "" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 208 10 
"Solution: " }{TEXT 224 0 "" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 
13 "fib:=proc(n)\n" }{MPLTEXT 1 0 15 "if n<3 then 1;\n" }{MPLTEXT 1 0 
26 "  else fib(n-1)+fib(n-2);\n" }{MPLTEXT 1 0 8 "end if;\n" }{MPLTEXT
 1 0 9 "end proc:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 7 "fib(7);
" }}{PARA 11 "" 1 "" {XPPMATH 20 "\"#8" }}}{EXCHG {PARA 0 "" 0 "" 
{TEXT 226 0 "" }}{PARA 0 "" 0 "" {TEXT 226 162 "10. Write a procedure \+
f whose input is a list L and whose output is i if i is the first inde
x such that L[i] = 1 and whose output is FAIL if 1 is not in the list.
" }}{PARA 0 "" 0 "" {TEXT 226 0 "" }}}{EXCHG {PARA 0 "" 0 "" {TEXT 
208 10 "Solution: " }{TEXT 225 0 "" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 17 "f:=proc(L::list)\n" }{MPLTEXT 1 0 14 "  local i, j;\n
" }{MPLTEXT 1 0 22 "  for i to nops(L) do\n" }{MPLTEXT 1 0 20 "    if \+
L(i)=1 then \n" }{MPLTEXT 1 0 35 "      for j from i+1 to nops(L) do\n
" }{MPLTEXT 1 0 23 "        if L[j]=1 then\n" }{MPLTEXT 1 0 33 "      \+
  return j; break; end if;\n" }{MPLTEXT 1 0 14 "      end do;\n" }
{MPLTEXT 1 0 12 "    end if;\n" }{MPLTEXT 1 0 10 "  end do;\n" }
{MPLTEXT 1 0 12 "return FAIL;" }{MPLTEXT 1 0 1 "\n" }{MPLTEXT 1 0 9 "e
nd proc:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 20 "f([2,2,1,3,1,2,
1]); " }}{PARA 11 "" 1 "" {XPPMATH 20 "I%FAILG%*protectedG" }}}{EXCHG 
{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}{EXCHG {PARA 209 "" 0 "" {TEXT 
228 0 "" }}{PARA 209 "" 0 "" {TEXT 228 7 "- End -" }}}}
